import {
  "moonvcs/hello-policy/gen/interface/moonvcs/policy/evaluator",
}

warnings = "-44"

pkgtype(kind: "foreign_library")

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "heap-start-address": 16,
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportEvaluate:moonvcs:policy/evaluator@0.1.0#evaluate",
        "wasmExportEvaluatePostReturn:cabi_post_moonvcs:policy/evaluator@0.1.0#evaluate",
      ],
    },
  },
)
